# ============================================================================
# OpenVoxTuner - .gitignore
# ============================================================================

# --- JUCE / Projucer ---
JuceLibraryCode/
Builds/
*.jucer.bak
*.iss.bak

# --- Visual Studio ---
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.cachefile
*.VC.db
ipch/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Dd]ebug-*/
[Rr]elease-*/
x64/
x86/
Win32/
ARM/
ARM64/
*.aps
*.pch
*.vspscc
*.vssscc
*.tlog
*.lastbuildstate
*.unsuccessfulbuild
*.idb
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.log

# --- CMake (si utilise en alternative a Projucer) ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
cmake-build-*/

# --- Build artefacts ---
*.dll
*.lib
*.exp
*.ilk
*.pdb
*.so
*.dylib
*.a

# --- Fichiers IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Fichiers temporaires / de test (regle user 10) ---
# Les scripts de test dans test/ sont versionnes, mais les artefacts non.
test/build/
test/*.exe
test/*.obj
test/*.pdb

# --- Fichiers de configuration locaux ---
# L'utilisateur peut creer un .env.local pour ses reglages (non versionne)
.env.local
.env
!.env.example

# --- OpenVoxTuner generated folders ---
build/
build-mac/
build-mac-*/
build-test/
build-tests/
dist/
site-docs/
.venv-mkdocs/

/build/

#OpenVoxTuner_1.2.1.zip

# --- Debug session config files ---
.dbg/

# --- Test output artifacts ---
test/test_output.txt
test/__pycache__/
test/formant_benchmark_results.json

# --- Stale / duplicate source files ---
# (ancienne version a la racine Source/, maintenant a Source/dsp/ et trackee)

# --- Temporary diagnostic documents (not for production) ---
debug-*.md

docs/changelogs/
docs/internal/
docs/social/
docs/__MACOSX
