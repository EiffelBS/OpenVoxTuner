---
/** Support component props — accepts translation object for i18n. */
interface Props {
  t: any;
}
const { t } = Astro.props;

/** SVG icons are static across all locales. */
const icons = {
  heart: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>',
  coin: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
  code: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>',
};

/** Build options from translations. */
const options = [
  { icon: icons.heart, title: t.support.kofi.title, description: t.support.kofi.description, cta: t.support.kofi.cta, href: 'https://ko-fi.com', color: 'red' },
  { icon: icons.coin, title: t.support.patreon.title, description: t.support.patreon.description, cta: t.support.patreon.cta, href: 'https://patreon.com', color: 'purple' },
  { icon: icons.heart, title: t.support.sponsors.title, description: t.support.sponsors.description, cta: t.support.sponsors.cta, href: 'https://github.com/sponsors/EiffelBS', color: 'green' },
  { icon: icons.code, title: t.support.contribute.title, description: t.support.contribute.description, cta: t.support.contribute.cta, href: 'https://github.com/EiffelBS/OpenVoxTuner', color: 'cyan' },
];
---

<section id="support" class="support relative py-24 sm:py-32 px-6 overflow-hidden" data-scroll-section>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-pink-600/5 rounded-full blur-[150px]" />

  <div class="max-w-5xl mx-auto relative z-10">
    <header class="text-center mb-16">
      <h2 class="support-title support-animate text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white mb-4 sm:mb-6">
        {t.support.title}
        <span class="bg-gradient-to-r from-pink-400 to-red-400 bg-clip-text text-transparent">{t.support.titleHighlight}</span>
      </h2>
      <p class="text-base sm:text-lg text-gray-400 max-w-xl mx-auto">
        {t.support.subtitle}
      </p>
    </header>

    <div class="support-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {options.map((opt) => (
        <a href={opt.href} target="_blank" rel="noopener noreferrer"
          class="support-card support-animate group relative flex flex-col items-center text-center p-6 sm:p-8 rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:bg-white/[0.04] transition-all duration-300">
          <div class={`inline-flex items-center justify-center w-14 h-14 rounded-xl mb-5 text-white ${
            opt.color === 'red' ? 'bg-gradient-to-br from-red-500 to-pink-600 shadow-lg shadow-red-500/20' :
            opt.color === 'purple' ? 'bg-gradient-to-br from-purple-500 to-purple-600 shadow-lg shadow-purple-500/20' :
            opt.color === 'green' ? 'bg-gradient-to-br from-green-500 to-emerald-600 shadow-lg shadow-green-500/20' :
            'bg-gradient-to-br from-cyan-500 to-blue-600 shadow-lg shadow-cyan-500/20'
          }`} set:html={opt.icon} />
          <h3 class="text-xl font-bold text-white mb-2">{opt.title}</h3>
          <p class="text-gray-400 leading-relaxed text-sm mb-5 flex-1">{opt.description}</p>
          <span class={`inline-block px-5 py-2 rounded-full text-sm font-semibold transition-colors duration-300 ${
            opt.color === 'red' ? 'bg-red-500/10 text-red-400 group-hover:bg-red-500/20' :
            opt.color === 'purple' ? 'bg-purple-500/10 text-purple-400 group-hover:bg-purple-500/20' :
            opt.color === 'green' ? 'bg-green-500/10 text-green-400 group-hover:bg-green-500/20' :
            'bg-cyan-500/10 text-cyan-400 group-hover:bg-cyan-500/20'
          }`}>{opt.cta}</span>
        </a>
      ))}
    </div>

    <p class="text-center text-gray-600 text-sm mt-10">
      {t.support.footer}
    </p>
  </div>
</section>

<style>
  .support-animate {
    opacity: 0;
    transform: translateY(60px) scale(0.9);
  }
</style>
