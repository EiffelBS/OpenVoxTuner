---
/** Hero component props — accepts translation object for i18n. */
interface Props {
  t: any;
}
const { t } = Astro.props;
---
<section class="hero relative min-h-[110vh] flex items-center justify-center overflow-hidden">
  <!-- Animated gradient orbs -->
  <div class="hero-orb hero-orb-1 absolute w-[600px] h-[600px] rounded-full bg-blue-600/30 blur-[120px] -top-40 -left-40" />
  <div class="hero-orb hero-orb-2 absolute w-[500px] h-[500px] rounded-full bg-purple-600/20 blur-[100px] -bottom-20 -right-20" />
  <div class="hero-orb hero-orb-3 absolute w-[300px] h-[300px] rounded-full bg-cyan-500/15 blur-[80px] top-1/3 left-1/2" />

  <!-- Grid pattern overlay -->
  <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:60px_60px]" />

  <!-- Radial vignette -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,black_70%)]" />

  <!-- Floating particles -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="particle absolute w-1.5 h-1.5 bg-blue-400/40 rounded-full" style="top: 15%; left: 10%; animation: float 20s ease-in-out infinite;"></div>
    <div class="particle absolute w-2 h-2 bg-purple-400/30 rounded-full" style="top: 60%; left: 85%; animation: float 25s ease-in-out infinite reverse;"></div>
    <div class="particle absolute w-1 h-1 bg-cyan-400/50 rounded-full" style="top: 30%; left: 5%; animation: float 18s ease-in-out infinite;"></div>
    <div class="particle absolute w-1.5 h-1.5 bg-pink-400/30 rounded-full" style="top: 75%; left: 15%; animation: float 22s ease-in-out infinite reverse;"></div>
    <div class="particle absolute w-1 h-1 bg-indigo-400/40 rounded-full" style="top: 45%; left: 90%; animation: float 15s ease-in-out infinite;"></div>
    <div class="particle absolute w-2 h-2 bg-blue-300/20 rounded-full" style="top: 80%; left: 60%; animation: float 28s ease-in-out infinite;"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 py-32 text-center z-10">
    <!-- Plugin icon -->
    <img
      src="/assets/icon.svg"
      alt="OpenVoxTuner icon"
      class="hero-icon w-28 h-28 md:w-32 md:h-32 rounded-2xl mx-auto mb-8 shadow-2xl shadow-blue-500/20"
      loading="eager"
    />

    <!-- Badge -->
    <div class="hero-badge inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 backdrop-blur-sm text-sm font-medium mb-8 text-blue-400">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
      </span>
      v0.1.1 — Open Source AGPLv3
    </div>

    <!-- Main title — will be split into chars by GSAP -->
    <h1 class="hero-title text-6xl md:text-8xl lg:text-9xl font-black tracking-tighter mb-8" data-animate="hero-title">
      <span class="bg-gradient-to-r from-white via-blue-200 to-purple-300 bg-clip-text text-transparent">
        OpenVoxTuner
      </span>
    </h1>

    <!-- Subtitle — words will animate in -->
    <p class="hero-subtitle text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto mb-12 leading-relaxed" data-animate="hero-subtitle">
      {t.hero.subtitle}
    </p>

    <!-- CTAs -->
    <div class="hero-ctas flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a
        href="#download"
        class="group relative px-8 py-4 rounded-2xl bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold text-lg overflow-hidden transition-all shadow-2xl shadow-blue-500/25 hover:shadow-blue-500/40"
        data-magnetic
      >
        <span class="relative z-10 flex items-center gap-2">
          {t.hero.cta}
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-blue-500 to-purple-500 opacity-0 group-hover:opacity-100 transition-opacity" />
      </a>
      <a
        href="https://github.com/EiffelBS/OpenVoxTuner"
        class="px-8 py-4 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm text-gray-300 font-semibold text-lg hover:bg-white/10 hover:border-white/20 transition-all"
        data-magnetic
      >
        {t.hero.secondaryCta}
      </a>
    </div>

    <!-- Tech badges -->
    <div class="hero-badges flex items-center justify-center gap-6 text-xs text-gray-500">
      <span class="px-3 py-1 rounded-full border border-white/5 bg-white/5">VST3</span>
      <span class="px-3 py-1 rounded-full border border-white/5 bg-white/5">AU</span>
      <span class="px-3 py-1 rounded-full border border-white/5 bg-white/5">Standalone</span>
      <span class="px-3 py-1 rounded-full border border-white/5 bg-white/5">ARA2</span>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-gray-500">
    <span class="text-xs tracking-widest uppercase">Scroll</span>
    <div class="w-5 h-8 rounded-full border border-gray-600 flex justify-center pt-1.5">
      <div class="w-1 h-2 bg-gray-400 rounded-full animate-bounce" />
    </div>
  </div>
</section>

<style is:global>
  @keyframes float {
    0%, 100% { transform: translateY(0) translateX(0); }
    25% { transform: translateY(-30px) translateX(15px); }
    50% { transform: translateY(15px) translateX(-10px); }
    75% { transform: translateY(-20px) translateX(5px); }
  }

  .particle {
    opacity: 0.5;
  }

  /* Waveform line animations */
  @keyframes waveShift1 {
    0% { transform: translateX(0) scaleY(1); }
    50% { transform: translateX(-40px) scaleY(1.3); }
    100% { transform: translateX(0) scaleY(1); }
  }
  @keyframes waveShift2 {
    0% { transform: translateX(0) scaleY(1); }
    50% { transform: translateX(30px) scaleY(0.7); }
    100% { transform: translateX(0) scaleY(1); }
  }
  @keyframes waveShift3 {
    0% { transform: translateX(0) scaleY(1); }
    50% { transform: translateX(-25px) scaleY(1.4); }
    100% { transform: translateX(0) scaleY(1); }
  }
  @keyframes waveShift4 {
    0% { transform: translateX(0) scaleY(1); }
    50% { transform: translateX(35px) scaleY(0.6); }
    100% { transform: translateX(0) scaleY(1); }
  }
  @keyframes waveShift5 {
    0% { transform: translateX(0) scaleY(1); }
    50% { transform: translateX(-20px) scaleY(1.5); }
    100% { transform: translateX(0) scaleY(1); }
  }
  @keyframes waveShiftCenter {
    0% { transform: translateX(0) scaleY(1); }
    33% { transform: translateX(15px) scaleY(1.6); }
    66% { transform: translateX(-15px) scaleY(0.6); }
    100% { transform: translateX(0) scaleY(1); }
  }

  .hero-wave { transform-origin: center; }
  .hero-wave-1 { animation: waveShift1 8s ease-in-out infinite; }
  .hero-wave-2 { animation: waveShift2 10s ease-in-out infinite 1s; }
  .hero-wave-3 { animation: waveShift3 7s ease-in-out infinite 0.5s; }
  .hero-wave-4 { animation: waveShift4 12s ease-in-out infinite 2s; }
  .hero-wave-5 { animation: waveShift5 9s ease-in-out infinite 1.5s; }
  .hero-wave-center { animation: waveShiftCenter 6s ease-in-out infinite; }
</style>