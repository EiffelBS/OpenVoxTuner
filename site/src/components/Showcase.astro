---
/** Showcase component props — accepts translation object for i18n. */
interface Props {
  t: any;
}
const { t } = Astro.props;

/** Image sources stay the same across locales; text comes from translations. */
const imageSources = [
  '/assets/screenshots/main_screen.png',
  '/assets/screenshots/harmony_types.png',
  '/assets/screenshots/curve_editor.png',
  '/assets/screenshots/curve_pianoroll.png',
];

const screenshots = t.showcase.slides.map((slide: any, i: number) => ({
  src: imageSources[i],
  title: slide.title,
  description: slide.description,
  tag: slide.tag,
}));
---

<section class="showcase relative overflow-hidden" data-scroll-section>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,rgba(59,130,246,0.06),transparent_60%)]" />

  <!-- Pinned: header + slides, GSAP pins this entire block -->
  <div class="showcase-pinned relative">
    <div class="showcase-sticky h-screen flex flex-col items-center justify-center overflow-hidden z-30">

      <!-- Header: stays visible, at the top of the pinned area -->
      <header class="showcase-header text-center pt-10 sm:pt-16 pb-6 sm:pb-8 px-4 relative z-20 shrink-0">
        <h2 class="showcase-title text-3xl sm:text-4xl md:text-6xl font-black tracking-tight text-white mb-3 sm:mb-4">
          {t.showcase.title}
          <span class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">{t.showcase.titleHighlight}</span>
        </h2>
        <p class="text-base sm:text-lg text-gray-400 max-w-2xl mx-auto">
          {t.showcase.subtitle}
        </p>
      </header>

      <!-- Slides: stacked, first one visible immediately -->
      <div class="relative flex-1 w-full">
        {screenshots.map((s, i) => (
          <div class={`showcase-slide absolute inset-0 flex flex-col items-center justify-center px-4 sm:px-6 ${i > 0 ? 'opacity-0 pointer-events-none' : ''}`} data-slide={i}>
            <div class="relative w-full max-w-5xl rounded-xl overflow-hidden" style="background-color: #000; aspect-ratio: 16/10; max-height: 50vh;">
              <img
                src={s.src}
                alt={s.title}
                class="showcase-img absolute inset-0 w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="showcase-text mt-4 sm:mt-6 text-center max-w-2xl">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-mono tracking-wider uppercase mb-3 bg-white/5 text-gray-300 border border-white/10">{s.tag}</span>
              <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-white leading-tight mb-2">{s.title}</h3>
              <p class="text-gray-400 leading-relaxed text-sm sm:text-base">{s.description}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Progress dots -->
      <div class="showcase-dots absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-3 z-10">
        {screenshots.map((_, i) => (
          <div class={`showcase-dot w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-white w-8' : 'bg-gray-600'}`} data-dot={i} />
        ))}
      </div>

      <!-- Counter -->
      <div class="absolute bottom-6 right-6 sm:right-12 text-gray-600 font-mono text-sm z-10">
        <span data-counter-current>1</span>
        <span class="text-gray-700">/</span>
        <span>4</span>
      </div>
    </div>
  </div>
</section>
