---
/** Features component props — accepts translation object for i18n. */
interface Props {
  t: any;
}
const { t } = Astro.props;
---
<section class="features relative py-32 px-6 overflow-hidden" data-scroll-section>
  <!-- Background glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-600/5 rounded-full blur-[150px]" />

  <div class="max-w-6xl mx-auto relative z-10">
    <header class="text-center mb-20">
      <h2 class="features-title text-4xl md:text-6xl font-black tracking-tight text-white mb-6">
        {t.features.title}<br/>
        <span class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">{t.features.titleHighlight}</span>
      </h2>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        {t.features.subtitle}
      </p>
    </header>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <article class="feature-card group relative p-8 rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-sm overflow-hidden" data-tilt>
        <div class="absolute inset-0 bg-gradient-to-b from-blue-500/0 to-blue-500/[0.03] opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
        <div class="absolute -inset-px rounded-2xl bg-gradient-to-b from-blue-500/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10" style="mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude; padding: 1px;" />
        <div class="relative z-10">
          <div class="feature-icon inline-flex items-center justify-center w-14 h-14 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 text-white mb-6 shadow-lg shadow-blue-500/20">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">{t.features.pitchCorrection.title}</h3>
          <p class="text-gray-400 leading-relaxed">{t.features.pitchCorrection.description}</p>
        </div>
      </article>

      <article class="feature-card group relative p-8 rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-sm overflow-hidden" data-tilt>
        <div class="absolute inset-0 bg-gradient-to-b from-purple-500/0 to-purple-500/[0.03] opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
        <div class="absolute -inset-px rounded-2xl bg-gradient-to-b from-purple-500/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10" style="mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude; padding: 1px;" />
        <div class="relative z-10">
          <div class="feature-icon inline-flex items-center justify-center w-14 h-14 rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 text-white mb-6 shadow-lg shadow-purple-500/20">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">{t.features.harmonyEngine.title}</h3>
          <p class="text-gray-400 leading-relaxed">{t.features.harmonyEngine.description}</p>
        </div>
      </article>

      <article class="feature-card group relative p-8 rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-sm overflow-hidden" data-tilt>
        <div class="absolute inset-0 bg-gradient-to-b from-cyan-500/0 to-cyan-500/[0.03] opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
        <div class="absolute -inset-px rounded-2xl bg-gradient-to-b from-cyan-500/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10" style="mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude; padding: 1px;" />
        <div class="relative z-10">
          <div class="feature-icon inline-flex items-center justify-center w-14 h-14 rounded-xl bg-gradient-to-br from-cyan-500 to-cyan-600 text-white mb-6 shadow-lg shadow-cyan-500/20">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">{t.features.formantPreservation.title}</h3>
          <p class="text-gray-400 leading-relaxed">{t.features.formantPreservation.description}</p>
        </div>
      </article>

      <article class="feature-card group relative p-8 rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-sm overflow-hidden" data-tilt>
        <div class="absolute inset-0 bg-gradient-to-b from-green-500/0 to-green-500/[0.03] opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
        <div class="absolute -inset-px rounded-2xl bg-gradient-to-b from-green-500/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10" style="mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude; padding: 1px;" />
        <div class="relative z-10">
          <div class="feature-icon inline-flex items-center justify-center w-14 h-14 rounded-xl bg-gradient-to-br from-green-500 to-green-600 text-white mb-6 shadow-lg shadow-green-500/20">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">{t.features.keyDetection.title}</h3>
          <p class="text-gray-400 leading-relaxed">{t.features.keyDetection.description}</p>
        </div>
      </article>

      <article class="feature-card group relative p-8 rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-sm overflow-hidden" data-tilt>
        <div class="absolute inset-0 bg-gradient-to-b from-orange-500/0 to-orange-500/[0.03] opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
        <div class="absolute -inset-px rounded-2xl bg-gradient-to-b from-orange-500/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10" style="mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude; padding: 1px;" />
        <div class="relative z-10">
          <div class="feature-icon inline-flex items-center justify-center w-14 h-14 rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 text-white mb-6 shadow-lg shadow-orange-500/20">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">{t.features.realTimeVisualizer.title}</h3>
          <p class="text-gray-400 leading-relaxed">{t.features.realTimeVisualizer.description}</p>
        </div>
      </article>

      <article class="feature-card group relative p-8 rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-sm overflow-hidden" data-tilt>
        <div class="absolute inset-0 bg-gradient-to-b from-pink-500/0 to-pink-500/[0.03] opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
        <div class="absolute -inset-px rounded-2xl bg-gradient-to-b from-pink-500/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10" style="mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude; padding: 1px;" />
        <div class="relative z-10">
          <div class="feature-icon inline-flex items-center justify-center w-14 h-14 rounded-xl bg-gradient-to-br from-pink-500 to-pink-600 text-white mb-6 shadow-lg shadow-pink-500/20">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">{t.features.curveEditor.title}</h3>
          <p class="text-gray-400 leading-relaxed">{t.features.curveEditor.description}</p>
        </div>
      </article>

      <article class="feature-card group relative p-8 rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-sm overflow-hidden" data-tilt>
        <div class="absolute inset-0 bg-gradient-to-b from-yellow-500/0 to-yellow-500/[0.03] opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
        <div class="absolute -inset-px rounded-2xl bg-gradient-to-b from-yellow-500/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10" style="mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude; padding: 1px;" />
        <div class="relative z-10">
          <div class="feature-icon inline-flex items-center justify-center w-14 h-14 rounded-xl bg-gradient-to-br from-yellow-500 to-yellow-600 text-white mb-6 shadow-lg shadow-yellow-500/20">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">{t.features.midiOut.title}</h3>
          <p class="text-gray-400 leading-relaxed">{t.features.midiOut.description}</p>
        </div>
      </article>
    </div>
  </div>
</section>

